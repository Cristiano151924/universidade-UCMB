# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys / Data API)

# Endereço do projeto, ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable / anon). Pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (secret / service_role). NUNCA compartilhe nem coloque no navegador.
SUPABASE_SECRET_KEY=

# Final do "e-mail interno" usado para o login por usuário. O colaborador nunca vê isso.
LOGIN_DOMAIN=ucmb.local
